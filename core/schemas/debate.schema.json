{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://business-model-council.local/schemas/debate.json",
  "type": "object",
  "required": ["run_id", "project_id", "rounds", "decision_log"],
  "properties": {
    "run_id": { "type": "string" },
    "project_id": { "type": "string" },
    "rounds": { "type": "array", "items": { "enum": ["independent", "cross-examination", "synthesis"] } },
    "decision_log": { "type": "array", "items": { "type": "object" } },
    "minority_views": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
