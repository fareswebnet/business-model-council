{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://business-model-council.local/schemas/agent.json",
  "type": "object",
  "required": ["id", "kind", "mandate", "scope", "output_contract"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "kind": { "enum": ["public-lens", "domain-specialist", "synthesizer", "red-team"] },
    "mandate": { "type": "string", "minLength": 20 },
    "scope": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "evidence_policy": { "type": "string" },
    "output_contract": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "status": { "enum": ["active", "draft", "retired"] }
  },
  "additionalProperties": false
}
